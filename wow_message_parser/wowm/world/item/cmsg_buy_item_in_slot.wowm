cmsg CMSG_BUY_ITEM_IN_SLOT = 0x01A3 {
    Guid vendor;
    Item item;
    Guid bag;
    u8 bag_slot;
    u8 amount;
} {
    versions = "1 2";
}

cmsg CMSG_BUY_ITEM_IN_SLOT = 0x01A3 {
    Guid vendor;
    Item item;
    /// arcemu: VLack: 3.1.2 This is the slot's number on the vendor's panel, starts from 1
    u32 vendor_slot;
    Guid bag;
    u8 bag_slot;
    u32 amount;
} {
    versions = "3.3.5";
}

test CMSG_BUY_ITEM_IN_SLOT {
    vendor = 100;
    item = 200;
    vendor_slot = 1;
    bag = 300;
    bag_slot = 7;
    amount = 3;
} [
    0x00, 0x21, /* size */
    0xA3, 0x01, 0x00, 0x00, /* opcode */
    0x64, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* vendor */
    0xC8, 0x00, 0x00, 0x00, /* item */
    0x01, 0x00, 0x00, 0x00, /* vendor_slot */
    0x2C, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* bag */
    0x07, /* bag_slot */
    0x03, 0x00, 0x00, 0x00, /* amount */
] {
    versions = "3.3.5";
}
