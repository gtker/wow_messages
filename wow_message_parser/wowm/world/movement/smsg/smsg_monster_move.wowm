    guid = 0;
    unknown = 0x5A;
    spline_point = {
        x = 0.0;
        y = 0.0;
        z = 0.0;
    };
    spline_id = 0x11223344;
    move_type = NORMAL;
    movement = {
        spline_flags = NONE;
        duration = 0x01020304;
        splines = [
            {
                x = 1.0;
                y = 2.0;
                z = 3.0;
            },
            {
                x = -0.25;
                y = 1.5;
                z = -128.0;
            }
        ];
    };
} [
    0x00, 0x31, /* size */
    0xDD, 0x00, /* opcode */
    0x00, /* packed guid mask */
    0x5A, /* unknown */
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* spline_point */
    0x44, 0x33, 0x22, 0x11, /* spline_id */
    0x00, /* move_type: NORMAL */
    0x00, 0x00, 0x00, 0x00, /* spline_flags */
    0x04, 0x03, 0x02, 0x01, /* duration */
    0x02, 0x00, 0x00, 0x00, /* spline count */
    0x00, 0x00, 0x80, 0x3F, /* destination.x */
    0x00, 0x00, 0x00, 0x40, /* destination.y */
    0x00, 0x00, 0x40, 0x40, /* destination.z */
    0xFF, 0x37, 0x00, 0x80 /* packed midpoint offset */
] {
    versions = "3.3.5";
}

