enum MonsterMoveType : u8 {
    NORMAL = 0;
    STOP = 1;
    FACING_SPOT = 2;
    FACING_TARGET = 3;
    FACING_ANGLE = 4;
} {
    versions = "1.12 2 3";
}

smsg SMSG_MONSTER_MOVE = 0x00DD {
    PackedGuid guid;
    Vector3d spline_point;
    u32 spline_id;
    MonsterMoveType move_type;
    if (move_type == FACING_TARGET) {
        Guid target;
    } else if (move_type == FACING_ANGLE) {
        f32 angle;
    } else if (move_type == FACING_SPOT) {
        Vector3d position;
    }
    /* TODO CORRECT_LAYOUT vmangos has STOP that does not include these for SMSG_COMPRESSED_MOVES */
    SplineFlag spline_flags;
    u32 duration;
    MonsterMoveSplines splines;
} {
    versions = "1.12 2";
}

struct MonsterMoveDataVariant {
    /// DONE, final-facing, and animation-ID bits are omitted from wire flags.
    SplineFlag spline_flags;
    if (spline_flags & ANIMATION) {
        u8 animation_id;
        u32 animation_start_time;
    }
    u32 duration;
    if (spline_flags & PARABOLIC) {
        f32 vertical_acceleration;
        u32 effect_start_time;
    }
    if (spline_flags & FLYING || spline_flags & CATMULLROM) {
        u32 full_spline_count;
        Vector3d[full_spline_count] full_splines;
    } else {
        MonsterMoveSplines splines;
    }
} {
    versions = "3.3.5";
}

smsg SMSG_MONSTER_MOVE = 0x00DD {
    PackedGuid guid;
    /// cmangos-wotlk sets to 0
    u8 unknown;
    Vector3d spline_point;
    u32 spline_id;
    MonsterMoveType move_type;
    if (move_type == FACING_TARGET) {
        Guid target;
    } else if (move_type == FACING_ANGLE) {
        f32 angle;
    } else if (move_type == FACING_SPOT) {
        Vector3d position;
    }
    if (move_type != STOP) {
        MonsterMoveDataVariant movement;
    }
} {
    versions = "3.3.5";
}

test SMSG_MONSTER_MOVE {
    guid = 0;
    unknown = 0;
    spline_point = {
        x = 0.0;
        y = 0.0;
        z = 0.0;
    };
    spline_id = 0;
    move_type = STOP;
} [
    0x00, 0x15, /* size */
    0xDD, 0x00, /* opcode */
    0x00, /* guid */
    0x00, /* unknown */
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* spline_point */
    0x00, 0x00, 0x00, 0x00, /* spline_id */
    0x01, /* move_type: STOP */
] {
    versions = "3.3.5";
}

test SMSG_MONSTER_MOVE {
    guid = 0;
    unknown = 0;
    spline_point = {
        x = 0.0;
        y = 0.0;
        z = 0.0;
    };
    spline_id = 0;
    move_type = NORMAL;
    movement = {
        spline_flags = NONE;
        duration = 0x11223344;
        splines = [
            {
                x = 1.0;
                y = -2.0;
                z = 3.5;
            },
            {
                x = -0.25;
                y = 0.25;
                z = -1.0;
            },
        ];
    };
} [
    0x00, 0x31, /* size */
    0xDD, 0x00, /* opcode */
    0x00, /* guid */
    0x00, /* unknown */
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* spline_point */
    0x00, 0x00, 0x00, 0x00, /* spline_id */
    0x00, /* move_type: NORMAL */
    0x00, 0x00, 0x00, 0x00, /* spline_flags */
    0x44, 0x33, 0x22, 0x11, /* duration */
    0x02, 0x00, 0x00, 0x00, /* spline count */
    0x00, 0x00, 0x80, 0x3F, 0x00, 0x00, 0x00, 0xC0, 0x00, 0x00, 0x60, 0x40, /* destination */
    0xFF, 0x0F, 0x00, 0xFF, /* signed packed quarter-unit offset */
] {
    versions = "3.3.5";
}

test SMSG_MONSTER_MOVE {
    guid = 0;
    unknown = 0;
    spline_point = {
        x = 0.0;
        y = 0.0;
        z = 0.0;
    };
    spline_id = 0;
    move_type = NORMAL;
    movement = {
        spline_flags = FLYING;
        duration = 0x55667788;
        full_splines = [
            {
                x = 1.0;
                y = -2.0;
                z = 0.5;
            },
            {
                x = -4.0;
                y = 8.25;
                z = 9.5;
            },
        ];
    };
} [
    0x00, 0x39, /* size */
    0xDD, 0x00, /* opcode */
    0x00, /* guid */
    0x00, /* unknown */
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, /* spline_point */
    0x00, 0x00, 0x00, 0x00, /* spline_id */
    0x00, /* move_type: NORMAL */
    0x00, 0x20, 0x00, 0x00, /* FLYING */
    0x88, 0x77, 0x66, 0x55, /* duration */
    0x02, 0x00, 0x00, 0x00, /* full_spline_count */
    0x00, 0x00, 0x80, 0x3F, 0x00, 0x00, 0x00, 0xC0, 0x00, 0x00, 0x00, 0x3F, /* full point 1 */
    0x00, 0x00, 0x80, 0xC0, 0x00, 0x00, 0x04, 0x41, 0x00, 0x00, 0x18, 0x41, /* full point 2 */
] {
    versions = "3.3.5";
}

